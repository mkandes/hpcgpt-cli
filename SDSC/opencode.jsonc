{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "triton-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Triton AI",
      "options": {
        "baseURL": "{env:TRITON_AI_LLM_URL}"
      },
      "models": {
        "api-deepseek-v4-flash": {
          "name": "Deepseek v4 Flash",
          "options": {
            "stream": true
          },
	"api-gemma-4-26b": {
          "name": "Gemma 4 (26B)",
          "options": {
            "stream": true
          },
	"api-gpt-oss-120b": {
          "name": "GPT-OSS (120B)",
          "options": {
            "stream": true
          }
        }
      }
    }
  },
  "agent": {
    "support": {
      "model": "triton-ai/api-deepseek-v4-flash",
      "prompt": "{file:./prompts/support.txt}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    }
  },
  "mcp": {
    "slurm-server": {
      "type": "remote",
      "url": "http://localhost:8001/mcp",
      "enabled": true
    },
    "triton-ai-server": {
      "type": "remote", 
      "url": "http://localhost:8002/mcp",
      "enabled": true
    },
    "jira-server": {
      "type": "remote",
      "url": "http://localhost:8003/mcp", 
      "enabled": falseapi-deepseek-v4-flash
    },
    "knowledge-base-server": {
      "type": "remote",
      "url": "http://localhost:8004/mcp",
      "enabled": false
    }
  },
  "command": {
    "report": {
      // Description shown in the TUI
      "template": "{file:./prompts/report.txt}",
      "description": "Report an issue to the Expanse support team",
      "agent": "support",
      "model": "triton-ai/api-deepseek-v4-flash"
    }
  },
  // I'm disabling sharing as i don't think this is a feature we want on Expanse
  "share": "disabled",
  // Configure permissions to control what AI agents can do by default.
  "permission": {
    "edit": "ask",
    "bash": "ask"
  }
}
