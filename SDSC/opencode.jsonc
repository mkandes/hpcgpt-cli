{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "enabled_providers": ["triton-ai"],
  "provider": {
    "triton-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Triton AI",
      "options": {
        "baseURL": "https://tritonai-api.ucsd.edu",
        "apiKey": "{env:TRITON_AI_API_KEY}",
        "litellmProxy": true,
        "autoload": true
      },
      "models": {
        "api-deepseek-v4-flash": {
          "name": "Deepseek v4 Flash"
        },
        "api-gemma-4-31b": {
          "name": "Gemma 4 (31B)"
        },
        "api-gpt-oss-120b": {
          "name": "GPT-OSS (120B)"
        }
      },
    },
  },
  "model": "triton-ai/api-deepseek-v4-flash",
  "small_model": "triton-ai/api-gemma-4-31b",
  "permission": {
    "bash": "ask",
    "edit": "deny",
    "read": "allow",
    "write": "deny",
    "grep": "allow",
    "glob": "allow",
    "lsp": "deny",
    "apply_patch": "deny",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
  },
  "share": "disabled",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
  },
  "mode": {
    "support": {
      "tools": {
        "bash": true,
        "edit": false,
        "read": true,
        "write": false,
        "grep": true,
        "glob": true,
        "lsp": false,
        "apply_patch": false,
        "skill": true,
        "todowrite": false,
        "webfetch": true,
        "websearch": true,
        "question": true,
      }
    }
  },
}
